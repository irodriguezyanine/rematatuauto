# =============================================================================
# REMATA TU AUTO — Variables de entorno
# -----------------------------------------------------------------------------
# Solo las que empiezan con VITE_ se exponen al navegador (import.meta.env).
# Nunca pongas aqui SERVICE_ROLE ni claves AWS y luego prefijelas con VITE_.
# =============================================================================

# --- Formspree (landing / mismos endpoints que CMS si no cambias esto)
VITE_FORMSPREE_URL=

# --- Canonical / SEO (opcional)
# Produccion oficial: https://rematatuauto.cl y https://rematatuauto.com
VITE_PUBLIC_SITE_URL=

# =============================================================================
# CLOUDINARY — navegador (subida sin firma con upload preset público Vedisa)
# =============================================================================
VITE_CLOUDINARY_CLOUD=dct5mdxy7
VITE_CLOUDINARY_UNSIGNED_PRESET=VedisaRemates
VITE_CLOUDINARY_FOLDER=VedisaRemates

# Opcional: URL base de tu Cloudinary Assets (solo si algun dia armamos URLs desde front)
# VITE_CLOUDINARY_SECURE_BASE=

# -----------------------------------------------------------------------------
# CLOUDINARY — solo servidor / scripts / automatizaciones (sin prefijo VITE_)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Una sola cadena opcional equivalente en tooling antiguo (no es obligatorio si usas tres lineas):
# CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>

# =============================================================================
# SUPABASE — navegador (anon + proyecto; suficiente para Edge autored + Auth publico futuro)
# =============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# SUPABASE — solo CI, scripts locales, Edge Functions deploy o migraciones (NUNCA en cliente)
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# Para supabase CLI (login / link). Opcional en este repo.
SUPABASE_ACCESS_TOKEN=

# Dashboard → Settings → API → opcional ayuda mnemonica para documentacion
SUPABASE_PROJECT_REF=

# =============================================================================
# AMAZON WEB SERVICES — correo SES (solo backend seguro / jobs / servidor)
#
# Esta SPA no puede llamar SES con credenciales desde el navegador. Usa estas
# variables en: Vercel Functions, Supabase Edge, GitHub Actions, u otro host.
#
# SES: crear identidad/domino verificado en SES, salir del sandbox si aplica,
# IAM con permiso ses:SendEmail (o SendRawEmail) sobre el recurso correcto.
# =============================================================================
AWS_REGION=

# Credenciales usuario IAM programatico (o deja vacio y usa rol en Lambda/ECS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Session token STS (Lambda con rol suele usar credenciales rotativas; solo si aplicable)
AWS_SESSION_TOKEN=

# Remitente “From” debe ser identidad SES verificada o dominio del cual envias
AWS_SES_FROM_EMAIL=
AWS_SES_FROM_NAME=Vedisa Remates

# Correo para respuestas (opcional SES)
AWS_SES_REPLY_TO_EMAIL=

# Destinatarios internos cuando quieras notificar equipo (comma-separated si tu env lo soportara)
SES_TO_NOTIFICATIONS=
SES_CC=

# Opcional: Configuration Set SES para reputacion/eventos CloudWatch/Kinesis/SNS
AWS_SES_CONFIGURATION_SET=

# General (algunas SDK esperan cualquiera de los dos; manten igual que AWS_REGION suele bastar)
AWS_DEFAULT_REGION=

# Si un dia usas SES con endpoint regional explicito como variable de app (raro):
# AWS_SES_ENDPOINT=

# =============================================================================
# AWS — otros servicios usuales junto al ecosistema Vedisa / Tasaciones (backend)
#
# Opcional para futuras sincronizaciones Inventario DynamoDB desde tu stack.
# Tambien aqui sin VITE_: nunca cliente.
# =============================================================================
# AWS_REGION= (alias arriba o deja igual)
AWS_DYNAMODB_TABLE=
AWS_ENDPOINT_URL=

# =============================================================================
# Depuracion (opcional local)
# =============================================================================
# DEBUG=
